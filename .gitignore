# ============================================================
#  逐梦之夏（DreamSummer）· Git 忽略规则
# ============================================================

# ---------- 依赖与构建产物 ----------
node_modules/
dist/
*.log

# ---------- 本地临时产物（编辑器 / 系统 / 工具）----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.local
*.tmp
*.bak

# ---------- 环境变量（示例文件需保留）----------
.env
.env.*
!.env.example

# ---------- 助手工作目录（本地记忆与运行状态，不入库）----------
.workbuddy/

# ---------- 根目录一次性调试脚本 ----------
# 背景图裁剪 / 压缩、日志清理等本地工具，不属于站点源码
/compress_*.py
/clean_logs.py

# ---------- 根目录调试日志（已清空，保留规则作防御）----------
/*.txt

# ---------- 设计参考素材 ----------
# 保留 md 分析文档与审查脚本；忽略第三方站点截图（体积大且属外部版权内容）
/design-refs/*.png
/design-refs/**/*.png
!/design-refs/audit/*.py
!/design-refs/audit/*.js

# ---------- 背景图处理中间产物 ----------
/public/images/bg-check.txt
/public/images/bg1/
/public/images/bg2/
